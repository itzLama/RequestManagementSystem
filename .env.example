POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=request_management
POSTGRES_USER=request_user
POSTGRES_PASSWORD=replace_with_a_local_password

# Local Mailpit SMTP configuration
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MASAR_MAIL_FROM=no-reply@masar.local
MASAR_GUEST_TRACKING_SECRET=replace_with_a_long_random_secret
MASAR_GUEST_COOKIE_SECURE=false

# Optional private attachment storage. Disabled unless explicitly enabled.
# HTTP is accepted only for an explicitly allowed loopback development endpoint.
MASAR_ATTACHMENTS_STORAGE_ENABLED=false
MASAR_ATTACHMENTS_STORAGE_ENDPOINT=http://127.0.0.1:19000
MASAR_ATTACHMENTS_STORAGE_REGION=us-east-1
MASAR_ATTACHMENTS_STORAGE_BUCKET=masar-attachment-poc
MASAR_ATTACHMENTS_STORAGE_ACCESS_KEY=replace_with_a_local_storage_access_key
MASAR_ATTACHMENTS_STORAGE_SECRET_KEY=replace_with_a_long_random_storage_secret
MASAR_ATTACHMENTS_STORAGE_PATH_STYLE=true
MASAR_ATTACHMENTS_STORAGE_ALLOW_INSECURE_HTTP=true
MASAR_ATTACHMENTS_STORAGE_CONNECTION_TIMEOUT=2s
MASAR_ATTACHMENTS_STORAGE_API_CALL_ATTEMPT_TIMEOUT=5s
MASAR_ATTACHMENTS_STORAGE_API_CALL_TIMEOUT=10s
MASAR_ATTACHMENTS_STORAGE_MAX_CONNECTIONS=25

# Temporary safety gate until malware scanning and secure downloads are implemented.
MASAR_ATTACHMENTS_UPLOAD_ENABLED=false

# Optional ClamAV scanning. Start the explicit Compose profile before enabling.
MASAR_ATTACHMENTS_SCANNING_ENABLED=false
MASAR_ATTACHMENTS_SCANNING_HOST=127.0.0.1
MASAR_ATTACHMENTS_SCANNING_PORT=13310
MASAR_ATTACHMENTS_SCANNING_CONNECTION_TIMEOUT=2s
MASAR_ATTACHMENTS_SCANNING_SCAN_TIMEOUT=60s
MASAR_ATTACHMENTS_SCANNING_MAX_CONCURRENT=2
MASAR_ATTACHMENTS_SCANNING_MAX_ATTEMPTS=3
MASAR_ATTACHMENTS_SCANNING_RETRY_BACKOFF=1m
MASAR_ATTACHMENTS_SCANNING_CLAIM_TIMEOUT=10m
MASAR_ATTACHMENTS_SCANNING_MAX_STREAM_BYTES=26214400
MASAR_ATTACHMENTS_AUTOMATIC_SCANNING_ENABLED=false
MASAR_ATTACHMENTS_RECONCILIATION_ENABLED=false
MASAR_ATTACHMENTS_DESTRUCTIVE_RECONCILIATION_ENABLED=false
MASAR_ATTACHMENTS_GUEST_UPLOAD_ENABLED=false
MASAR_ATTACHMENTS_PROCESSING_BATCH_SIZE=10
MASAR_ATTACHMENTS_PROCESSING_INTERVAL=30s
MASAR_ATTACHMENTS_CLEANUP_GRACE_PERIOD=15m
MASAR_ATTACHMENTS_CLEANUP_RETRY_BACKOFF=5m
MASAR_ATTACHMENTS_CLEANUP_CLAIM_TIMEOUT=10m
MASAR_ATTACHMENTS_MAX_CLEANUP_ATTEMPTS=5
MASAR_ATTACHMENTS_GUEST_UPLOADS_PER_HOUR=20
