# Copy this file to .env and replace both credential placeholders.
# The local .env file is ignored by the repository-wide .gitignore.
RUSTFS_POC_ACCESS_KEY=REPLACE_WITH_LOCAL_POC_ACCESS_KEY
RUSTFS_POC_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_LOCAL_POC_SECRET

# Loopback-only host ports. These avoid Masar's existing service ports.
RUSTFS_POC_S3_PORT=19000
RUSTFS_POC_CONSOLE_PORT=19001

# Java POC settings.
RUSTFS_POC_ENDPOINT=http://127.0.0.1:19000
RUSTFS_POC_REGION=us-east-1
RUSTFS_POC_BUCKET=masar-attachment-poc
